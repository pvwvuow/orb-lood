# Copy to `.env` (never commit it) and fill in.
# deploy.sh creates this file on the VPS and keeps the secrets in
# /etc/orblood/secrets.env. Generate random values with:
#   openssl rand -hex 32

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orblood
DB_PASSWORD=CHANGE_ME
DB_NAME=orblood

# --- Auth ---
# 64+ random hex chars. The server refuses to start with a weak or
# previously-published value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server ---
# 127.0.0.1 when nginx runs on the same box (production). Docker: 0.0.0.0
HOST=127.0.0.1
PORT=4000
# Which proxy hop to trust for the client IP. nginx resolves the real
# visitor IP behind ArvanCloud and overwrites X-Forwarded-For, so
# "loopback" (only nginx on this machine) is right for the VPS.
TRUST_PROXY=loopback
PUBLIC_ORIGIN=https://orblood.ir
UPLOAD_DIR=./uploads
PUBLIC_UPLOADS_BASE=/uploads
# Max uploads per user per hour
UPLOAD_PER_HOUR=60

# --- Voice / TURN (self-hosted coturn) ---
#
# Managed by scripts/setup-voice.sh — run it instead of editing by hand.
#
# TURN_HOST must be a subdomain that points DIRECTLY at the VPS (CDN
# off). ArvanCloud would otherwise eat TURN traffic on :443.
TURN_HOST=turn.orblood.ir
# coturn runs with `use-auth-secret` + `static-auth-secret=<TURN_SECRET>`.
# The API turns this into short-lived per-user credentials, so no
# long-lived password ever reaches a browser.
TURN_SECRET=
# How long a handed-out TURN credential stays valid (seconds).
TURN_CREDENTIAL_TTL=86400
# TCP/TLS on :443 only. Iranian ISPs block outbound UDP, and both peers
# must land on the same coturn process for relay forwarding to work.
TURN_URLS=turn:turn.orblood.ir:443?transport=tcp,turns:turn.orblood.ir:443?transport=tcp
# Force every byte of audio through the TURN relay (filtered networks).
VOICE_FORCE_RELAY=true
# UDP TURN URLs are dropped from /api/voice/config unless this is true.
VOICE_ALLOW_UDP=false
# Log each signaling relay line (helpful while debugging calls).
VOICE_SIGNAL_LOG=1
